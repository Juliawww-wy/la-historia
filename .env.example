# LLM fallback (story / quiz / vocab-card) when user has no BYOK config
DEEPSEEK_API_KEY=

# Baidu Fanyi — Stage 1 Spanish→Chinese machine translation (NOT an LLM)
# Apply at https://fanyi-api.baidu.com/  (standard tier ~50k chars/month free)
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=

# Postgres connection string (Neon / Vercel Postgres) — accounts + vocab book.
# After setting this, run once: npx tsx db/migrate.ts
DATABASE_URL=

# Session cookie signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=
